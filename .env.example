# Local development only. These values are not secrets and must never be used outside a developer machine.
# docker-compose.yml already uses these values as defaults; copy this file to .env only to override them.

# PostgreSQL server (superuser used only by the init script and for administration)
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-local

# Mbia application database
MBIA_DB_NAME=mbia
MBIA_DB_USER=mbia
MBIA_DB_PASSWORD=mbia-local

# Keycloak database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-local

# Keycloak (ADR-005): http://localhost:8081, admin console user of the master realm
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local

# S3-compatible object storage (RustFS locally, ADR-009)
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=mbia-local
S3_SECRET_KEY=mbia-local-secret
S3_REGION=us-east-1
S3_BUCKET=mbia-media
# Endpoint the backend reaches, and endpoint the browser reaches (pre-signed URLs are signed for it).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
# The only origin allowed to upload directly to the bucket (bucket CORS, set by rustfs-init).
S3_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Mailpit (catches every email sent locally)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
