{
  "realm": "mbia",
  "displayName": "Mbia",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(8)",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@mbia.local",
    "fromDisplayName": "Mbia",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clients": [
    {
      "clientId": "mbia-web",
      "name": "Mbia web application",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": ["basic", "profile", "email", "web-origins", "acr"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "mbia-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mbia-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice@mbia.local",
      "email": "alice@mbia.local",
      "firstName": "Alice",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "locale": ["fr"] },
      "credentials": [{ "type": "password", "value": "alice-local-1", "temporary": false }]
    },
    {
      "username": "bob@mbia.local",
      "email": "bob@mbia.local",
      "firstName": "Bob",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "locale": ["en"] },
      "credentials": [{ "type": "password", "value": "bob-local-1", "temporary": false }]
    },
    {
      "username": "carol@mbia.local",
      "email": "carol@mbia.local",
      "firstName": "Carol",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": false,
      "attributes": { "locale": ["fr"] },
      "credentials": [{ "type": "password", "value": "carol-local-1", "temporary": false }]
    }
  ]
}
