# Keycloak settings on the staging VM: example values only. The real file is rendered from SSM Parameter Store
# to <MBIA_ENV_DIR>/keycloak.env (mode 0600, outside the repository) at deployment. Variables: README.md.
KC_HOSTNAME=https://auth.mbia-staging.lehnade.com
# Admin console, through an SSM port forward to the VM's 127.0.0.1:8081 (compose.yml).
KC_HOSTNAME_ADMIN=http://localhost:8081
KC_DB_URL=jdbc:postgresql://<rds endpoint>:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me
# Temporary admin of the master realm, created on the first start only: replace it by a named admin, then remove.
KC_BOOTSTRAP_ADMIN_USERNAME=change-me
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Read by the realm import (first start only): the mbia-web origin and Keycloak's emails (SES SMTP).
MBIA_WEB_ORIGIN=https://mbia-staging.lehnade.com
MBIA_KC_SMTP_HOST=email-smtp.eu-west-3.amazonaws.com
MBIA_KC_SMTP_PORT=587
MBIA_KC_SMTP_FROM=no-reply@mbia-staging.lehnade.com
MBIA_KC_SMTP_USERNAME=change-me
MBIA_KC_SMTP_PASSWORD=change-me
