# Backend settings on the staging VM: example values only. The real file is rendered from SSM Parameter Store
# to <MBIA_ENV_DIR>/backend.env (mode 0600, outside the repository) at deployment. Variables: README.md.
SPRING_DATASOURCE_URL=jdbc:postgresql://<rds endpoint>:5432/mbia
SPRING_DATASOURCE_USERNAME=mbia
SPRING_DATASOURCE_PASSWORD=change-me
# Public issuer, reached through Caddy's network alias (compose.yml): same for the browser and the backend.
MBIA_SECURITY_ISSUER_URI=https://auth.mbia-staging.lehnade.com/realms/mbia
MBIA_CORS_ALLOWED_ORIGINS=https://mbia-staging.lehnade.com
MBIA_STORAGE_BUCKET=<media bucket>
MBIA_STORAGE_REGION=eu-west-3
MBIA_STORAGE_PATH_STYLE_ACCESS=false
MBIA_APP_BASE_URL=https://mbia-staging.lehnade.com
MBIA_MAIL_FROM=Mbia <no-reply@mbia-staging.lehnade.com>
MBIA_SMTP_HOST=email-smtp.eu-west-3.amazonaws.com
MBIA_SMTP_PORT=587
MBIA_SMTP_USERNAME=change-me
MBIA_SMTP_PASSWORD=change-me
MBIA_PROBLEMS_BASE_URI=https://mbia-staging.lehnade.com/problems
