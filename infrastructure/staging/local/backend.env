# Local trial of the staging stack only (compose.local.yml, README.md): the local values of .env.example.
# Never used outside a developer machine.
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/mbia_staging
SPRING_DATASOURCE_USERNAME=mbia
SPRING_DATASOURCE_PASSWORD=mbia-local
MBIA_SECURITY_ISSUER_URI=http://auth.localhost/realms/mbia
MBIA_CORS_ALLOWED_ORIGINS=http://localhost:5173
MBIA_STORAGE_BUCKET=mbia-media
MBIA_STORAGE_REGION=us-east-1
MBIA_STORAGE_ENDPOINT=http://host.docker.internal:9000
MBIA_STORAGE_PUBLICENDPOINT=http://localhost:9000
MBIA_STORAGE_ACCESSKEY=mbia-local
MBIA_STORAGE_SECRETKEY=mbia-local-secret
MBIA_APP_BASE_URL=http://localhost:5173
MBIA_MAIL_FROM=Mbia <no-reply@mbia.localhost>
MBIA_SMTP_HOST=host.docker.internal
MBIA_SMTP_PORT=1025
MBIA_SMTP_AUTH=false
MBIA_SMTP_STARTTLS=false
