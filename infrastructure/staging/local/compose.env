# Interpolated variables of compose.yml for the local trial (README.md):
#   docker compose --env-file infrastructure/staging/local/compose.env \
#     -f infrastructure/staging/compose.yml -f infrastructure/staging/compose.local.yml up -d
MBIA_BACKEND_IMAGE=mbia-backend
MBIA_KEYCLOAK_IMAGE=mbia-keycloak
MBIA_API_HOST=api.localhost
MBIA_AUTH_HOST=auth.localhost
MBIA_ENV_DIR=./local
KEYCLOAK_ADMIN_PORT=8082
