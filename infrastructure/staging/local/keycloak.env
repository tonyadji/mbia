# Local trial of the staging stack only (compose.local.yml, README.md): the local values of .env.example.
# Never used outside a developer machine.
KC_HOSTNAME=http://auth.localhost
KC_HOSTNAME_ADMIN=http://localhost:8082
KC_DB_URL=jdbc:postgresql://host.docker.internal:5432/keycloak_staging
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak-local
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-local
MBIA_WEB_ORIGIN=http://localhost:5173
MBIA_KC_SMTP_HOST=host.docker.internal
MBIA_KC_SMTP_PORT=1025
MBIA_KC_SMTP_FROM=no-reply@mbia.localhost
MBIA_KC_SMTP_AUTH=false
MBIA_KC_SMTP_STARTTLS=false
MBIA_KC_SMTP_USERNAME=
MBIA_KC_SMTP_PASSWORD=
