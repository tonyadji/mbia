# Local development only. Copy to .env.local to override the defaults.

# Base URL of the Mbia API (defaults to the local backend below when unset).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Keycloak realm (OIDC issuer) and public client of the web application (defaults to the local realm below when unset).
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/mbia
VITE_OIDC_CLIENT_ID=mbia-web

# Support contact offered for account deletion requests (mvp.md §30). When unset, no contact link is shown.
VITE_SUPPORT_EMAIL=support@mbia.local
